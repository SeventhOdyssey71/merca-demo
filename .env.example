# Sui fullnode RPC. Defaults to mainnet.
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Optional: a Sui private key (suiprivkey1... bech32 form) used by sign-mark-tx.ts.
# Never commit a real key. Treat the file holding this as if it were a wallet.
SUI_PRIVATE_KEY=

# Optional: opt-in to integration tests that hit live RPC.
RUN_INTEGRATION=
